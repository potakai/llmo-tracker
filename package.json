{
  "name": "llmo-tracker",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @llmo/db generate",
    "db:migrate": "pnpm --filter @llmo/db migrate",
    "db:studio": "pnpm --filter @llmo/db studio",
    "auth:generate": "pnpm --filter web auth:generate",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "ask": "pnpm --filter @llmo/llm ask",
    "db:seed": "pnpm --filter web db:seed",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
