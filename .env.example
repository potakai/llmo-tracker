# docker compose の Postgres に接続する
DATABASE_URL=postgres://llmo:llmo@localhost:5432/llmo
# `pnpm test` が使うDB（テストのたびに中身を作り直す）
TEST_DATABASE_URL=postgres://llmo:llmo@localhost:5432/llmo_test

# Better Auth（`openssl rand -base64 32` で生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI の呼び出し。fake = API を叩かない（費用ゼロ）、live = 本物の API を叩く
LLM_MODE=fake
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 空ならコード側の初期値（gpt-5.4-mini / gemini-3.8-flash）
OPENAI_MODEL=
GEMINI_MODEL=

# run（計測）をどこで実行するか。未設定 = Next.js と同じプロセス（開発用）、trigger = Trigger.dev（本番用）
RUN_DISPATCH=
# Trigger.dev の Secret key（ダッシュボードの API keys）。RUN_DISPATCH=trigger と `pnpm jobs:dev` で使う
TRIGGER_SECRET_KEY=
