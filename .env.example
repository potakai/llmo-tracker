# docker compose の Postgres に接続する
DATABASE_URL=postgres://llmo:llmo@localhost:5432/llmo
# `pnpm test` が使うDB（テストのたびに中身を作り直す）
TEST_DATABASE_URL=postgres://llmo:llmo@localhost:5432/llmo_test

# Better Auth（`openssl rand -base64 32` で生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI の呼び出し。fake = API を叩かない（費用ゼロ）、live = 本物の API を叩く
LLM_MODE=fake
# 本物の AI を使ってよい組織の ID（カンマ区切り。`*` ならすべて）。LLM_MODE=live でも、ここにない組織はフェイクで計測する
# 組織の ID は pnpm db:studio の organization テーブルで確かめられる
LIVE_ORGANIZATION_IDS=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 空ならコード側の初期値（gpt-5.4-mini / gemini-3.8-flash）
OPENAI_MODEL=
GEMINI_MODEL=

# Google の検索順位と AI による概要（DataForSEO）。fake = API を叩かない（費用ゼロ）、live = 本物の API を叩く
# 本物を使うのは LIVE_ORGANIZATION_IDS にある組織だけ（AI と同じ一覧）。LLM_MODE とは別なので、DataForSEO だけを止められる
SERP_MODE=fake
# DataForSEO の API のログインとパスワード（ダッシュボードの API Access にあるもの。アカウントのパスワードではない）
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# サイト診断（ブランドに登録したドメインのサイトを読む）。fake = 読まない（作り物の HTML で診断する）、live = 本物のサイトを読む
# 本物を読むのは LIVE_ORGANIZATION_IDS にある組織だけ（AI・DataForSEO と同じ一覧）
SITE_MODE=fake

# run（計測）をどこで実行するか。未設定 = Next.js と同じプロセス（開発用）、inngest = Inngest（本番用）
RUN_DISPATCH=
# 手元の Inngest 開発サーバー（`pnpm inngest:dev`）を使うときは 1。キーなしで動く。本番では設定しない
INNGEST_DEV=
# Inngest のキー（ダッシュボードの Event Keys / Signing Key）。本番の RUN_DISPATCH=inngest で使う
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
